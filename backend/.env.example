# Copy this file to .env and fill in your actual values

# Neon PostgreSQL connection string
# Format: postgresql+psycopg://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql+psycopg://your_user:your_password@your_host/your_database?sslmode=require

# JWT settings - use a strong random secret key in production
SECRET_KEY=your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# App settings
APP_NAME=LifeRoute API
APP_VERSION=1.0.0
DEBUG=true

